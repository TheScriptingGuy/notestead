// M1-S6 lint NEG fixture F1-f: a Promise-wrapped setTimeout sleep in a node:test acceptance test (.mts).
import assert from 'node:assert/strict';
import { it } from 'node:test';

it('a sleep in an acceptance test must be rejected', async () => {
	await new Promise(resolve => setTimeout(resolve, 100));
	assert.equal(1 + 1, 2);
});
