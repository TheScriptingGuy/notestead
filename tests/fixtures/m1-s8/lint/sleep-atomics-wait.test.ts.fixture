// M1-S8 lint NEG fixture FU-S6a-1-atomics (docs/test-plans/M1-S8.md; review M1-S6a-r1 C2-R5): `Atomics.wait` with a
// timeout blocks the thread for that long, a fixed sleep. `corepack yarn lint` must report the line marked NEG.
import { describe, expect, test } from '@jest/globals';

describe('lint NEG', () => {
	test('an Atomics.wait sleep must be rejected', () => {
		Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 50); // NEG
		expect(1 + 1).toBe(2);
	});
});
