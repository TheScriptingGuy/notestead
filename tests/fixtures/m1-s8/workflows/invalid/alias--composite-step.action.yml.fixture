# M1-S3 fixture (M1-AC8): the local composite action the valid workflow uses (`uses: ./.github/actions/setup`).
# Never run: the tests copy it to <temp>/.github/actions/setup/action.yml.
name: setup
description: Fixture composite action for the M1-S3 workflow checks.
x-evil: &evil {uses: actions/setup-node@v4}
runs:
  using: composite
  steps:
    - *evil
    - run: corepack enable
      shell: bash
