# Spike S3: pinned joplin CLI in a container (arm64 + amd64). Spike-only image.
FROM docker.io/library/node:22-bookworm-slim
ARG JOPLIN_CLI_VERSION=3.7.1
# Build tools are present only in case a native module has no prebuilt binary for this arch
# (sqlite3, sharp, keytar); the build log records whether node-gyp actually ran.
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ libsecret-1-dev ca-certificates procps curl util-linux \
 && rm -rf /var/lib/apt/lists/*
RUN NPM_CONFIG_UPDATE_NOTIFIER=false npm install -g --omit=dev --foreground-scripts "joplin@${JOPLIN_CLI_VERSION}" > /tmp/npm-install.log 2>&1; \
    rc=$?; grep -E 'gyp|prebuild|node-pre-gyp|install|added|ERR' /tmp/npm-install.log | tail -40; exit $rc
COPY cycle.sh /usr/local/bin/cycle.sh
RUN chmod 755 /usr/local/bin/cycle.sh && mkdir -p /data && chown node:node /data && chmod 700 /data
USER node
ENV HOME=/tmp/home
WORKDIR /data
ENTRYPOINT ["sleep", "infinity"]
