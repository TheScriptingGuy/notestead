# The Notestead `headless` image (ADR-0003, ADR-0006, ADR-0008; ADR-0009 A4 and A11): the supervisor in
# packages/headless and the pinned Joplin CLI, both installed from this repository's yarn.lock. Build with the
# repository root as the context (.containerignore keeps local installs and caches out):
#   podman build -f packages/headless/Containerfile -t <tag> .
# Run hardened (ADR-0006): --init --read-only --tmpfs /tmp --cap-drop=ALL --security-opt no-new-privileges
# --memory 768m, on the internal backend network only, a volume at /data and the secrets under /run/secrets.
# See packages/headless/README.md.

# The official multi-arch Node image (linux/amd64 and linux/arm64 among others), pinned by its index digest; Node 22
# LTS as ADR-0009 requires (>= 22.19: type stripping runs the supervisor's TypeScript). Change both together.
ARG NODE_IMAGE=docker.io/library/node:22.23.3-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c

FROM ${NODE_IMAGE} AS install
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
	YARN_ENABLE_TELEMETRY=0 \
	YARN_ENABLE_PROGRESS_BARS=0 \
	FORCE_COLOR=0
WORKDIR /app
# Every workspace manifest, so yarn sees the same project yarn.lock describes; then the whole headless package.
COPY package.json yarn.lock .yarnrc.yml ./
COPY packages/web-build/package.json packages/web-build/
COPY packages/headless/ packages/headless/
# 1. Immutable: yarn.lock must already describe these manifests. `yarn workspaces focus` doesn't honour --immutable,
#    so resolve without linking and refuse any change to the lockfile.
RUN cp yarn.lock /tmp/yarn.lock.committed \
	&& corepack yarn install --mode=update-lockfile \
	&& if ! cmp -s yarn.lock /tmp/yarn.lock.committed; then \
		echo 'yarn.lock does not match the manifests: run `corepack yarn install` and commit yarn.lock' >&2; \
		diff /tmp/yarn.lock.committed yarn.lock >&2; \
		exit 1; \
	fi
# 2. A focused production install of the headless workspace from yarn.lock. Install scripts stay off
#    (.yarnrc.yml enableScripts: false) except for the one allow-list, the root package.json "dependenciesMeta"
#    (today sqlite3, which fetches its prebuilt native binding).
RUN corepack yarn workspaces focus --production headless \
	&& rm -rf .yarn

FROM ${NODE_IMAGE}
COPY --from=install /app /app
# The profile volume: owned by the runtime user, so a fresh named volume mounted here inherits that owner.
RUN mkdir -p /data && chown 1000:1000 /data && chmod 0700 /data
ENV NODE_ENV=production
# The base image's `node` user.
USER 1000:1000
WORKDIR /data
EXPOSE 8090
ENTRYPOINT ["node", "/app/packages/headless/bin/supervisor.ts"]
CMD []
